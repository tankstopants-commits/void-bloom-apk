<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover">
  <title>VOID BLOOM</title>
  <style>
    body { margin: 0; overflow: hidden; background: #000; color: #fff; font-family: sans-serif; touch-action: none; }
    canvas { display: block; width: 100vw; height: 100vh; image-rendering: pixelated; }
    #ui { position: fixed; top: 0; left: 0; right: 0; bottom: 0; pointer-events: none; z-index: 10; }
    #menu { position: absolute; inset: 0; background: rgba(0,0,0,0.9); display: flex; flex-direction: column; align-items: center; justify-content: center; pointer-events: auto; }
    button { padding: 15px 30px; font-size: 18px; background: #8b0012; color: white; border: 2px solid #fff; cursor: pointer; text-transform: uppercase; letter-spacing: 2px; }
    button:hover { background: #a00015; }
    #hud { position: absolute; top: 10px; left: 10px; font-family: monospace; font-size: 14px; color: #ccc; display: none; }
    .controls { position: absolute; bottom: 20px; right: 20px; display: none; gap: 10px; pointer-events: auto; }
    .ctrl-btn { width: 60px; height: 60px; border-radius: 50%; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.3); color: white; font-size: 24px; display: flex; align-items: center; justify-content: center; user-select: none; -webkit-user-select: none; }
    #stick-area { position: absolute; bottom: 20px; left: 20px; width: 120px; height: 120px; border-radius: 50%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1); display: none; pointer-events: auto; }
    #knob { position: absolute; top: 50%; left: 50%; width: 40px; height: 40px; margin: -20px 0 0 -20px; border-radius: 50%; background: rgba(255,255,255,0.3); }
  </style>
</head>
<body>
  <canvas id="game"></canvas>
  
  <div id="ui">
    <div id="menu">
      <h1 style="color:#8b0012; margin-bottom:20px; text-shadow: 0 0 10px red;">VOID BLOOM</h1>
      <button id="startBtn">ENTER VOID</button>
    </div>
    
    <div id="hud">FRAGMENTS: <span id="fragCount">0/6</span></div>
    
    <div class="controls" id="touchControls">
      <div class="ctrl-btn" id="btnFlash">🔦</div>
      <div class="ctrl-btn" id="btnRun">🏃</div>
    </div>
    
    <div id="stick-area"><div id="knob"></div></div>
  </div>

<script>
(function(){
  'use strict';
  
  // --- CONFIG ---
  const MAP_SIZE = 33;
  const CELL = 2.0;
  const FOV = 0.72;
  
  // --- STATE ---
  let canvas, ctx, W, H;
  let map = [];
  let player = { x: 1.5, y: 1.5, dirX: -1, dirY: 0, planeX: 0, planeZ: FOV };
  let entity = { x: MAP_SIZE-2.5, y: MAP_SIZE-2.5, active: true };
  let gameState = 'MENU'; // MENU, PLAYING, DEAD
  let fragmentsCollected = 0;
  let lastTime = 0;
  let moveSpeed = 3.0;
  let rotSpeed = 2.0;
  
  // Input state
  let keys = {};
  let joystick = { active: false, dx: 0, dy: 0 };
  let lookTouch = null;
  
  // Textures (Procedural for size efficiency)
  let wallTex, floorTex, bearTex, fragTex;

  function init() {
    canvas = document.getElementById('game');
    ctx = canvas.getContext('2d', { alpha: false });
    
    resize();
    window.addEventListener('resize', resize);
    
    generateMap();
    createTextures();
    
    document.getElementById('startBtn').addEventListener('click', startGame);
    setupInputs();
    
    requestAnimationFrame(loop);
  }

  function resize() {
    // Low resolution for performance on weak devices
    const scale = 0.5; 
    W = Math.floor(window.innerWidth * scale);
    H = Math.floor(window.innerHeight * scale);
    canvas.width = W;
    canvas.height = H;
    canvas.style.width = '100%';
    canvas.style.height = '100%';
  }

  function generateMap() {
    // Simple maze generation
    for(let y=0; y<MAP_SIZE; y++) {
      let row = [];
      for(let x=0; x<MAP_SIZE; x++) {
        if(x===0 || y===0 || x===MAP_SIZE-1 || y===MAP_SIZE-1) row.push(0); // Walls
        else if(Math.random() > 0.85) row.push(0); // Random walls
        else row.push(1); // Floor
      }
      map.push(row);
    }
    // Ensure start/end are clear
    map[1][1] = 1; map[1][2] = 1; map[2][1] = 1;
    map[MAP_SIZE-2][MAP_SIZE-2] = 1;
  }

  function createTextures() {
    // Wall Texture (Brick-like)
    wallTex = document.createElement('canvas');
    wallTex.width = 64; wallTex.height = 64;
    let wCtx = wallTex.getContext('2d');
    wCtx.fillStyle = '#4a3c3c'; wCtx.fillRect(0,0,64,64);
    wCtx.strokeStyle = '#2a1c1c'; wCtx.lineWidth = 2;
    for(let i=0; i<64; i+=16) { wCtx.beginPath(); wCtx.moveTo(i,0); wCtx.lineTo(i,64); wCtx.stroke(); }
    for(let i=0; i<64; i+=16) { wCtx.beginPath(); wCtx.moveTo(0,i); wCtx.lineTo(64,i); wCtx.stroke(); }
    
    // Bear Sprite
    bearTex = document.createElement('canvas');
    bearTex.width = 64; bearTex.height = 128;
    let bCtx = bearTex.getContext('2d');
    bCtx.fillStyle = '#5a3a2a'; 
    bCtx.fillRect(10, 40, 44, 60); // Body
    bCtx.beginPath(); bCtx.arc(32, 30, 20, 0, Math.PI*2); bCtx.fill(); // Head
    bCtx.fillStyle = '#ff0000'; bCtx.fillRect(25, 25, 4, 4); bCtx.fillRect(35, 25, 4, 4); // Eyes
    
    // Fragment Glow
    fragTex = document.createElement('canvas');
    fragTex.width = 32; fragTex.height = 32;
    let fCtx = fragTex.getContext('2d');
    let grad = fCtx.createRadialGradient(16,16,0,16,16,16);
    grad.addColorStop(0, '#0ff'); grad.addColorStop(1, 'transparent');
    fCtx.fillStyle = grad; fCtx.fillRect(0,0,32,32);
  }

  function startGame() {
    gameState = 'PLAYING';
    document.getElementById('menu').style.display = 'none';
    document.getElementById('hud').style.display = 'block';
    document.getElementById('touchControls').style.display = 'flex';
    document.getElementById('stick-area').style.display = 'block';
    lastTime = performance.now();
  }

  function loop(now) {
    requestAnimationFrame(loop);
    if(gameState !== 'PLAYING') return;
    
    let dt = (now - lastTime) / 1000;
    lastTime = now;
    if(dt > 0.1) dt = 0.1; // Cap delta time
    
    update(dt);
    render();
  }

  function update(dt) {
    // Movement from Keyboard
    let moveX = 0, moveY = 0;
    if(keys['KeyW'] || keys['ArrowUp']) moveY -= 1;
    if(keys['KeyS'] || keys['ArrowDown']) moveY += 1;
    if(keys['KeyA'] || keys['ArrowLeft']) moveX -= 1;
    if(keys['KeyD'] || keys['ArrowRight']) moveX += 1;
    
    // Normalize diagonal movement
    if(moveX !== 0 && moveY !== 0) {
      let len = Math.sqrt(moveX*moveX + moveY*moveY);
      moveX /= len; moveY /= len;
    }
    
    // Apply Joystick input
    if(joystick.active) {
      moveX += joystick.dx;
      moveY += joystick.dy;
    }
    
    // Calculate forward/right vectors based on direction
    let fx = player.dirX;
    let fy = player.dirY;
    let rx = -player.planeX; // Right vector is perpendicular to plane? No, standard raycaster uses plane for rotation.
    // Actually, in simple raycaster:
    // Forward is dirX, dirY.
    // Right is usually derived from cross product or just swapping axes if axis-aligned.
    // Let's use standard rotation matrix logic for movement relative to view.
    
    // Move Player
    let speed = moveSpeed * dt;
    let newX = player.x + (fx * -moveY + rx * moveX) * speed;
    let newY = player.y + (fy * -moveY + ry * moveX) * speed; // Need ry calculation
    
    // Simplified collision check (grid based)
    if(map[Math.floor(newY)][Math.floor(newX)] === 1) {
      player.x = newX;
      player.y = newY;
    }
    
    // Rotation from Touch Look
    if(lookTouch) {
      // Handled in event listeners directly modifying player angle
    }
    
    // Entity Logic (Simple Chase)
    let distToPlayer = Math.hypot(player.x - entity.x, player.y - entity.y);
    if(distToPlayer < 15) {
      // Move towards player slowly
      let ex = (player.x - entity.x) / distToPlayer;
      let ey = (player.y - entity.y) / distToPlayer;
      let espeed = 1.5 * dt;
      let nextEX = entity.x + ex * espeed;
      let nextEY = entity.y + ey * espeed;
      
      if(map[Math.floor(nextEY)][Math.floor(nextEX)] === 1) {
        entity.x = nextEX;
        entity.y = nextEY;
      }
      
      if(distToPlayer < 1.5) {
        alert("CAUGHT BY THE BEAR!");
        location.reload();
      }
    }
  }
  
  // Helper for rotation/movement math
  function rotate(angle) {
    let oldDirX = player.dirX;
    player.dirX = player.dirX * Math.cos(angle) - player.dirY * Math.sin(angle);
    player.dirY = oldDirX * Math.sin(angle) + player.dirY * Math.cos(angle);
    let oldPlaneX = player.planeX;
    player.planeX = player.planeX * Math.cos(angle) - player.planeZ * Math.sin(angle);
    player.planeZ = oldPlaneX * Math.sin(angle) + player.planeZ * Math.cos(angle);
  }

  function render() {
    // Clear Background
    ctx.fillStyle = '#050505';
    ctx.fillRect(0, 0, W, H);
    
    // Ceiling/Floor gradient approximation
    let grd = ctx.createLinearGradient(0, 0, 0, H);
    grd.addColorStop(0, "#000");
    grd.addColorStop(0.5, "#111");
    grd.addColorStop(1, "#000");
    ctx.fillStyle = grd;
    ctx.fillRect(0, 0, W, H);
    
    // Raycasting
    let zBuffer = new Float32Array(W);
    
    for(let x = 0; x < W; x++) {
      let cameraX = 2 * x / W - 1;
      let rayDirX = player.dirX + player.planeX * cameraX;
      let rayDirY = player.dirY + player.planeZ * cameraX;
      
      let mapX = Math.floor(player.x);
      let mapY = Math.floor(player.y);
      
      let sideDistX, sideDistY;
      let deltaDistX = (rayDirX === 0) ? 1e30 : Math.abs(1 / rayDirX);
      let deltaDistY = (rayDirY === 0) ? 1e30 : Math.abs(1 / rayDirY);
      
      let stepX, stepY;
      let hit = 0;
      let side = 0;
      
      if(rayDirX < 0) { stepX = -1; sideDistX = (player.x - mapX) * deltaDistX; }
      else { stepX = 1; sideDistX = (mapX + 1.0 - player.x) * deltaDistX; }
      
      if(rayDirY < 0) { stepY = -1; sideDistY = (player.y - mapY) * deltaDistY; }
      else { stepY = 1; sideDistY = (mapY + 1.0 - player.y) * deltaDistY; }
      
      while(hit === 0) {
        if(sideDistX < sideDistY) { sideDistX += deltaDistX; mapX += stepX; side = 0; }
        else { sideDistY += deltaDistY; mapY += stepY; side = 1; }
        
        if(mapX >= 0 && mapX < MAP_SIZE && mapY >= 0 && mapY < MAP_SIZE) {
          if(map[mapY][mapX] === 0) hit = 1;
        } else { hit = 1; } // Out of bounds acts as wall
      }
      
      let perpWallDist = (side === 0) ? (sideDistX - deltaDistX) : (sideDistY - deltaDistY);
      zBuffer[x] = perpWallDist;
      
      let lineHeight = Math.floor(H / perpWallDist);
      let drawStart = -lineHeight / 2 + H / 2;
      if(drawStart < 0) drawStart = 0;
      let drawEnd = lineHeight / 2 + H / 2;
      if(drawEnd >= H) drawEnd = H - 1;
      
      // Draw Wall Strip
      let texNum = 0; // Single texture for now
      let wallX; 
      if(side === 0) wallX = player.y + perpWallDist * rayDirY;
      else wallX = player.x + perpWallDist * rayDirX;
      wallX -= Math.floor(wallX);
      
      let texX = Math.floor(wallX * 64);
      if(side === 0 && rayDirX > 0) texX = 64 - texX - 1;
      if(side === 1 && rayDirY < 0) texX = 64 - texX - 1;
      
      ctx.drawImage(wallTex, texX, 0, 1, 64, x, drawStart, 1, drawEnd - drawStart);
      
      // Shading
      let darkness = Math.min(0.8, perpWallDist / 20);
      if(side === 1) darkness += 0.1; // Side shading
      ctx.fillStyle = `rgba(0,0,0,${darkness})`;
      ctx.fillRect(x, drawStart, 1, drawEnd - drawStart);
    }
    
    // Draw Sprites (Bear & Fragments)
    // Sort sprites by distance
    let sprites = [
      { x: entity.x, y: entity.y, tex: bearTex, w: 1.5, h: 3.0 },
      // Add fragment logic here later
    ];
    
    sprites.sort((a,b) => {
      let da = (a.x - player.x)**2 + (a.y - player.y)**2;
      let db = (b.x - player.x)**2 + (b.y - player.y)**2;
      return db - da;
    });
    
    for(let s of sprites) {
      let spriteX = s.x - player.x;
      let spriteY = s.y - player.y;
      
      let invDet = 1.0 / (player.planeX * player.dirY - player.dirX * player.planeZ);
      let transformX = invDet * (player.dirY * spriteX - player.dirX * spriteY);
      let transformY = invDet * (-player.planeZ * spriteX + player.planeX * spriteY);
      
      if(transformY <= 0) continue; // Behind player
      
      let spriteScreenX = Math.floor((W / 2) * (1 + transformX / transformY));
      let spriteHeight = Math.abs(Math.floor(H / transformY)) * s.h;
      let drawStartY = -spriteHeight / 2 + H / 2;
      if(drawStartY < 0) drawStartY = 0;
      let drawEndY = spriteHeight / 2 + H / 2;
      if(drawEndY >= H) drawEndY = H - 1;
      
      let spriteWidth = Math.abs(Math.floor(H / transformY)) * s.w;
      let drawStartX = -spriteWidth / 2 + spriteScreenX;
      let drawEndX = spriteWidth / 2 + spriteScreenX;
      
      if(drawStartX < 0) drawStartX = 0;
      if(drawEndX >= W) drawEndX = W - 1;
      
      for(let stripe = Math.floor(drawStartX); stripe < drawEndX; stripe++) {
        if(stripe < 0 || stripe >= W) continue;
        if(transformY < zBuffer[stripe]) {
           let texX = Math.floor((stripe - (-spriteWidth/2 + spriteScreenX)) * s.tex.width / spriteWidth);
           ctx.drawImage(s.tex, texX, 0, 1, s.tex.height, stripe, drawStartY, 1, drawEndY - drawStartY);
        }
      }
    }
  }

  function setupInputs() {
    // Keyboard
    window.addEventListener('keydown', e => keys[e.code] = true);
    window.addEventListener('keyup', e => keys[e.code] = false);
    
    // Touch Joystick
    let stickArea = document.getElementById('stick-area');
    let knob = document.getElementById('knob');
    
    stickArea.addEventListener('touchstart', e => {
      e.preventDefault();
      joystick.active = true;
    }, {passive: false});
    
    stickArea.addEventListener('touchmove', e => {
      e.preventDefault();
      if(!joystick.active) return;
      let rect = stickArea.getBoundingClientRect();
      let centerX = rect.left + rect.width/2;
      let centerY = rect.top + rect.height/2;
      let touch = e.touches[0];
      let dx = touch.clientX - centerX;
      let dy = touch.clientY - centerY;
      let dist = Math.hypot(dx, dy);
      let maxDist = rect.width/2 - 20;
      if(dist > maxDist) {
        dx = dx/dist * maxDist;
        dy = dy/dist * maxDist;
      }
      knob.style.transform = `translate(${dx}px, ${dy}px)`;
      joystick.dx = dx / maxDist;
      joystick.dy = dy / maxDist;
    }, {passive: false});
    
    stickArea.addEventListener('touchend', e => {
      joystick.active = false;
      joystick.dx = 0;
      joystick.dy = 0;
      knob.style.transform = `translate(0px, 0px)`;
    });
    
    // Look Control (Right side screen)
    window.addEventListener('touchstart', e => {
      if(e.target.closest('#stick-area') || e.target.closest('.controls')) return;
      if(e.touches.length > 0) {
         lookTouch = { x: e.touches[0].clientX, y: e.touches[0].clientY };
      }
    }, {passive: false});
    
    window.addEventListener('touchmove', e => {
      if(!lookTouch) return;
      let touch = e.touches[0];
      let dx = touch.clientX - lookTouch.x;
      // Rotate player
      let angle = -dx * 0.005;
      rotate(angle);
      lookTouch.x = touch.clientX;
    }, {passive: false});
    
    window.addEventListener('touchend', () => lookTouch = null);
  }

  init();
})();
</script>
</body>
</html>
